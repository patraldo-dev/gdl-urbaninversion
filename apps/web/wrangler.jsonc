{
  // SvelteKit Worker (adapter-cloudflare, Workers Static Assets).
  // Production is the top-level environment; staging overrides name, routes
  // and vars. The adapter is pointed at this file from vite.config.js.
  // Built with `vite build` first; `wrangler deploy` then publishes the
  // worker plus assets. /api/* and /ws never reach this Worker: the presence
  // Worker holds more specific routes for those paths on the same hostnames.
  "$schema": "node_modules/wrangler/config.schema.json",
  "name": "urbaninversion-web",
  "main": ".svelte-kit/cloudflare/_worker.js",
  // Workers Builds hardening (the ambientx greenroom lesson): the whole
  // build chain runs inside the deploy via node directly — no npm/npx PATH
  // or registry round-trip, and the XR bundle is always fresh-built from the
  // pushed source instead of a possibly stale committed copy. npm (unlike
  // pnpm) hoists shared deps to the repo root, so web's vite 8 is invoked
  // via ../../node_modules while cwd stays apps/web (SvelteKit resolves
  // config paths against cwd); xr's vite 7 is nested in apps/xr.
  "build": {
    "command": "cd ../xr && node node_modules/vite/bin/vite.js build && cd ../web && node scripts/copy-xr.mjs && node ../../node_modules/vite/bin/vite.js build"
  },
  // VERIFY: bump to the compatibility date of the wrangler version used at deploy time.
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },

  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
    // VERIFY: confirm /xr vs /xr/ both serve the XR index in the staging
    // smoke test; site links are canonicalized to /xr/ regardless.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  "routes": [
    { "pattern": "urbaninversion.com/*", "zone_name": "urbaninversion.com", "custom_domain": false }
  ],

  // Read by hooks.server.js to set X-Robots-Tag: noindex on staging.
  "vars": { "NOINDEX": "false" },

  "env": {
    "staging": {
      "name": "urbaninversion-web-staging",
      "workers_dev": false,
      "routes": [
        { "pattern": "staging.urbaninversion.com/*", "zone_name": "urbaninversion.com", "custom_domain": false }
      ],
      "vars": { "NOINDEX": "true" }
    }
  }
}
