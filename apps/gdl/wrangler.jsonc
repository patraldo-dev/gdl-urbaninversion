{
  // GDL Urban Inversion AR tour — SvelteKit (adapter-cloudflare v7, output
  // .cloudflare/). Migrated 2026-10-21 from the standalone gdl-urbaninversion
  // worker (code history: the repo's legacy-scaffold branch) into this
  // monorepo as apps/gdl. Prod serves GDL.urbaninversion.com; staging is its
  // own Worker (urbaninversion-gdl-staging) on staging-gdl.urbaninversion.com.
  // NEVER USE PAGES — Ishmael's mandate
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urbaninversion-gdl",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".cloudflare/worker.js",
  // Workers Builds hardening (the ambientx greenroom lesson): build runs
  // inside the deploy via node directly — no npm/npx PATH or registry
  // round-trip, bundle always fresh-built from the pushed source.
  "build": {
    "command": "node node_modules/vite/bin/vite.js build"
  },
  "assets": {
    "directory": ".cloudflare/public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gdl-urbaninversion",
      "database_id": "06b8a678-1a9a-41c4-933d-c20410dd383a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_ASSETS",
      "bucket_name": "gdl-astronomy-assets"
    }
  ],
  "routes": [
    {
      "pattern": "GDL.urbaninversion.com",
      "custom_domain": true
    }
  ],
  // --- Staging environment ---
  // Deploys as its own Worker: urbaninversion-gdl-staging. Bindings are NOT
  // inherited from the top level, so everything is repeated. D1 is a separate
  // database (seeded 2026-10-21 from prod export); R2 and AI are shared with
  // prod, matching the ambientx-oz-staging pattern.
  "env": {
    "staging": {
      "name": "urbaninversion-gdl-staging",
      "workers_dev": true,
      "assets": {
        "directory": ".cloudflare/public",
        "binding": "ASSETS"
      },
      "ai": {
        "binding": "AI"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gdl-urbaninversion-staging",
          "database_id": "28ebc1c2-ab08-4eef-9f1d-b2ac1c84dc9c"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2_ASSETS",
          "bucket_name": "gdl-astronomy-assets"
        }
      ],
      "routes": [
        {
          "pattern": "staging-gdl.urbaninversion.com",
          "custom_domain": true
        }
      ]
    }
  }
}
