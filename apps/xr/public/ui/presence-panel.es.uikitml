<!--
  Presence state toggle + glanceable status rows. Status rows start hidden
  and are toggled with display in src/ui/presence-ui.js (only verified
  setProperties APIs are used; no text-update API is assumed).
-->
<style>
  @font-face {
    font-family: 'UIInter';
    src: url('fonts/inter-latin-400-normal.ttf') format('truetype');
    font-weight: 400;
  }
  @font-face {
    font-family: 'UIInter';
    src: url('fonts/inter-latin-700-normal.ttf') format('truetype');
    font-weight: 700;
  }
  .panel-root { flex-direction: column; width: 344px; }
  .panel-content { align-items: flex-start; flex-direction: column; padding-top: 12px; padding-left: 24px; padding-right: 24px; }
  .heading { height: 32px; font-size: 20px; font-weight: 700; line-height: 24px; color: #272727; }
  .heading:dark { color: rgba(255, 255, 255, 0.9); }
  .status { font-size: 13px; line-height: 17px; color: #a35b00; margin-top: 4px; display: none; }
  .status:dark { color: #ffc46b; }
  .button { justify-content: flex-start; margin-left: 24px; margin-right: 24px; margin-top: 12px; }
  .button-last { margin-bottom: 24px; }
  .button-label {
    font-family: 'UIInter';
  }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="heading">Tu presencia</div>
    <div id="status-coarse" class="status">Ubicación demasiado imprecisa para marcadores individuales - solo se muestran conteos.</div>
    <div id="status-align" class="status">Alineación: baja - camina recto unos segundos.</div>
    <div id="status-location-error" class="status">Ubicación no disponible.</div>
    <div id="status-offline" class="status">Presencia desconectada.</div>
    <div id="status-aggregate" class="status">Cerca: conteos de abiertos y tranquilos.</div>
  </div>
  <Button id="state-open" class="button">
    <ButtonIcon><MessageCircle></MessageCircle></ButtonIcon>
    <ButtonLabel class="button-label">Abierto a platicar</ButtonLabel>
  </Button>
  <Button id="state-quiet" class="button">
    <ButtonIcon><Headphones></Headphones></ButtonIcon>
    <ButtonLabel class="button-label">Tranquilo - por favor no te acerques</ButtonLabel>
  </Button>
  <Button id="state-observer" class="button">
    <ButtonIcon><Eye></Eye></ButtonIcon>
    <ButtonLabel class="button-label">Observador - solo conteos</ButtonLabel>
  </Button>
  <Button id="state-invisible" class="button">
    <ButtonIcon><EyeOff></EyeOff></ButtonIcon>
    <ButtonLabel class="button-label">Invisible - desconectar</ButtonLabel>
  </Button>
  <Button id="exit-xr" class="button button-last">
    <ButtonIcon><LogIn></LogIn></ButtonIcon>
    <ButtonLabel class="button-label">Salir de XR</ButtonLabel>
  </Button>
</Panel>
