<!--
  2D-mode menu panel (replaces the IWSDK scaffold demo). Brand, one-line
  pitch, the XR enter/exit buttons (wired in src/panel.js), and site menu
  buttons (also src/panel.js). Localized per locale suffix; selected by
  src/assets.js from the preferredLanguage cookie.
-->
<style>
  @font-face {
    font-family: 'UIInter';
    src: url('../fonts/inter-latin-400-normal.ttf') format('truetype');
    font-weight: 400;
  }
  @font-face {
    font-family: 'UIInter';
    src: url('../fonts/inter-latin-700-normal.ttf') format('truetype');
    font-weight: 700;
  }
  .panel-root { flex-direction: column; width: 344px; }
  .panel-content { align-items: center; flex-direction: column; padding-top: 16px; padding-left: 24px; padding-right: 24px; }
  .heading { font-family: 'UIInter'; height: 48px; text-align: center; font-size: 24px; font-weight: 700; line-height: 24px; letter-spacing: -0.5px; color: #272727; }
  .heading:dark { color: rgba(255, 255, 255, 0.9); }
  .sub-heading { font-family: 'UIInter'; color: #272727; font-size: 14px; font-weight: 500; line-height: 18px; width: 100%; margin-top: 10px; text-align: center; }
  .sub-heading:dark { color: rgba(255, 255, 255, 0.9); }
  .button { justify-content: flex-start; margin-left: 24px; margin-right: 24px; margin-top: 16px; }
  .button-last { margin-bottom: 24px; }
  .button-label { font-family: 'UIInter'; transform-translate-y: 1px; }
</style>
<Panel class="panel-root">
  <div class="panel-content">
    <div class="heading">Urban Inversion</div>
    <Divider></Divider>
    <div class="sub-heading">See who nearby is open to a conversation - and who wants quiet. No accounts, nothing stored.</div>
  </div>
  <Button id="xr-button" class="button">
    <ButtonIcon><RectangleGoggles></RectangleGoggles></ButtonIcon>
    <ButtonLabel class="button-label">Enter XR</ButtonLabel>
  </Button>
  <Button id="exit-button" class="button" style="display: none">
    <ButtonIcon><LogIn></LogIn></ButtonIcon>
    <ButtonLabel class="button-label">Exit to browser</ButtonLabel>
  </Button>
  <Button id="menu-home" class="button">
    <ButtonLabel class="button-label">Site home</ButtonLabel>
  </Button>
  <Button id="menu-how" class="button">
    <ButtonLabel class="button-label">How it works</ButtonLabel>
  </Button>
  <Button id="menu-privacy" class="button button-last">
    <ButtonLabel class="button-label">Privacy &amp; safety</ButtonLabel>
  </Button>
</Panel>
