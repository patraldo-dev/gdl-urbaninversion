{
  "name": "@urbaninversion/presence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy",
    "migrate:staging": "wrangler d1 migrations apply urbaninversion-presence-staging --env staging",
    "migrate:production": "wrangler d1 migrations apply urbaninversion-presence-production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@urbaninversion/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "~5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
