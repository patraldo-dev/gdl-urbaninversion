{
  // GDL Urban Inversion — deployed as CF Worker on GDL.urbaninversion.com
  // NEVER USE PAGES — Ishmael's mandate
  "name": "gdl-urbaninversion",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".cloudflare/worker.js",
  "assets": {
    "directory": ".cloudflare/public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gdl-urbaninversion",
      "database_id": "06b8a678-1a9a-41c4-933d-c20410dd383a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_ASSETS",
      "bucket_name": "gdl-astronomy-assets"
    }
  ],
  "routes": [
    {
      "pattern": "GDL.urbaninversion.com",
      "custom_domain": true
    }
  ]
}
